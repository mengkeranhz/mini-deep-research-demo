{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mini-deep-research:travel-planner:itinerary:v1",
  "title": "Travel itinerary artifact",
  "description": "A machine-readable travel plan. Markdown remains the user-facing deliverable; this artifact supports verification and iteration.",
  "type": "object",
  "required": ["schema_version", "trip", "days"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": 1},
    "trip": {"$ref": "#/$defs/trip"},
    "days": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/day"}},
    "budget": {"$ref": "#/$defs/budget"},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "trip": {
      "type": "object",
      "required": ["variant", "origin", "destination", "start_date", "end_date", "transport_mode"],
      "additionalProperties": true,
      "properties": {
        "variant": {"type": "string"},
        "origin": {"type": "string"},
        "destination": {"type": "string"},
        "start_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "end_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "transport_mode": {"type": "string"},
        "participants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "objectives": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"$ref": "urn:mini-deep-research:travel-planner:travel-fact:v1#/$defs/constraint"}},
        "route_structure": {"type": "string"},
        "total_distance": {"type": "string"},
        "total_driving_duration": {"type": "string", "pattern": "^PT"}
      }
    },
    "day": {
      "type": "object",
      "required": ["day_id", "date", "events"],
      "additionalProperties": true,
      "properties": {
        "day_id": {"type": "string"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "summary": {"type": "string"},
        "lodging": {"$ref": "#/$defs/lodging"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "extensions": {"type": "object", "additionalProperties": true}
      }
    },
    "event": {
      "type": "object",
      "required": ["event_id", "event_type", "start", "end", "title"],
      "additionalProperties": true,
      "properties": {
        "event_id": {"type": "string"},
        "event_type": {
          "type": "string",
          "enum": ["transport", "sightseeing", "meal", "rest", "lodging", "fueling", "ticketing", "preparation", "buffer", "other"]
        },
        "start": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
        "end": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
        "title": {"type": "string"},
        "location": {"type": "string"},
        "route": {"$ref": "urn:mini-deep-research:travel-planner:travel-fact:v1#/$defs/route"},
        "duration": {"type": "string", "pattern": "^PT"},
        "cost": {"type": "object", "additionalProperties": true},
        "physical_intensity": {"type": "string"},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"},
        "extensions": {"type": "object", "additionalProperties": true}
      }
    },
    "lodging": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "place": {"type": "string"},
        "nights": {"type": "integer", "minimum": 1},
        "reason": {"type": "string"},
        "price_band": {"type": "string"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "currency": {"type": "string"},
        "total_range": {"type": "string"},
        "per_person_range": {"type": "string"},
        "categories": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      }
    }
  }
}
